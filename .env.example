JUMPING_AGENT_TOKEN=replace-with-a-long-random-development-token
JUMPING_AGENT_ID=store-main
JUMPING_OPERATOR_PIN=replace-with-development-pin
JUMPING_SESSION_SECRET=replace-with-at-least-32-random-development-characters
PAYMENT_EXPLICIT_EXECUTION_V2=false
PAYMENT_TRANSPORT=CLOUD_FAST_LANE
LOCAL_PAYMENT_BRIDGE_URL=http://127.0.0.1:8765
WEB_PUSH_VAPID_PUBLIC_KEY=replace-with-p256-public-key
WEB_PUSH_VAPID_PRIVATE_JWK=replace-with-private-jwk-json
WEB_PUSH_VAPID_SUBJECT=mailto:developer@example.com

# Store Bridge only. Never put parking credentials in cloud hosting.
PARKING_BASE_URL=https://parking.example.com
PARKING_USER_ID=replace-with-store-user
PARKING_PASSWORD=replace-with-store-password
PARKING_LOT_AREA=replace-with-lot-area
PARKING_MEMBER_ID=replace-with-member-id
PARKING_DRY_RUN=true
PARKING_TIMEOUT_SECONDS=8
